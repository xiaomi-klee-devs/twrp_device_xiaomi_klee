# ============================================================================
# Main device init rc (MT6899 / klee)
# Imports the boot-control and keymint/TEE service definitions and sets up
# early boot props, SELinux enforcing, USB controller and the loader
# services started on `boot`.
# ============================================================================

import /init.recovery.bootctl.rc
import /init.recovery.keymint.rc

on early-init
    write /sys/fs/selinux/enforce 1
    setprop vendor.haptics.ready 0

on init
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

on property:servicemanager.ready=true
    start vendor.boot-default

service load-touch-modules /sbin/sh /system/bin/load-touch-modules.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service create-bootdevice-link /sbin/sh /system/bin/create-bootdevice-link.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service load-haptic-modules /system/bin/load-haptic-modules.sh
    disabled
    oneshot
    user root
    group root input system
    seclabel u:r:recovery:s0

on early-boot
    exec_start load-touch-modules

on boot
    start boot-hal-1-2
    start health-hal-2-1
    start create-bootdevice-link
    start load-haptic-modules
