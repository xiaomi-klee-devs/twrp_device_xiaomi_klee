From 2134162064afb31c175db760cc561c670f210c95 Mon Sep 17 00:00:00 2001
From: kylieeXD <khayloaftck@gmail.com>
Date: Sat, 5 Sep 2026 13:14:03 +0700
Subject: [PATCH] events: Add rodin haptics compatibility

Change-Id: I93a7488ca499ae8a1647588c19ef087159028935
Signed-off-by: kylieeXD <khayloaftck@gmail.com>
---
 minuitwrp/events.cpp | 46 ++++++++++++++++++++++++++++----------------
 1 file changed, 29 insertions(+), 17 deletions(-)

diff --git a/minuitwrp/events.cpp b/minuitwrp/events.cpp
index 3c481a0..46e4e5d 100644
--- a/minuitwrp/events.cpp
+++ b/minuitwrp/events.cpp
@@ -65,17 +65,20 @@ static std::atomic_int vib_on_count = 0;
 #define LEDS_HAPTICS_DURATION_FILE	"/sys/class/leds/vibrator/duration"
 #define LEDS_HAPTICS_ACTIVATE_FILE	"/sys/class/leds/vibrator/activate"
 
-// klee's AWINIC driver exposes haptics directly on its I2C device.
-#define AWINIC_HAPTIC_DURATION_FILE \
-    "/sys/bus/i2c/devices/0-005a/duration"
-#define AWINIC_HAPTIC_ACTIVATE_FILE \
-    "/sys/bus/i2c/devices/0-005a/activate"
-
-// klee's ICS driver exposes haptics directly on its I2C device.
-#define ICS_HAPTIC_DURATION_FILE \
-    "/sys/bus/i2c/devices/0-005f/duration"
-#define ICS_HAPTIC_ACTIVATE_FILE \
-    "/sys/bus/i2c/devices/0-005f/activate"
+#define FA_HAPTIC_DURATION_FILE "/sys/bus/i2c/devices/0-005a/duration"
+#define FA_HAPTIC_ACTIVATE_FILE "/sys/bus/i2c/devices/0-005a/activate"
+
+#define FC_HAPTIC_DURATION_FILE "/sys/bus/i2c/devices/0-005c/duration"
+#define FC_HAPTIC_ACTIVATE_FILE "/sys/bus/i2c/devices/0-005c/activate"
+
+#define FE_HAPTIC_DURATION_FILE "/sys/bus/i2c/devices/0-005e/duration"
+#define FE_HAPTIC_ACTIVATE_FILE "/sys/bus/i2c/devices/0-005e/activate"
+
+#define FF_HAPTIC_DURATION_FILE "/sys/bus/i2c/devices/0-005f/duration"
+#define FF_HAPTIC_ACTIVATE_FILE "/sys/bus/i2c/devices/0-005f/activate"
+
+#define SB_HAPTIC_DURATION_FILE "/sys/bus/i2c/devices/0-006b/duration"
+#define SB_HAPTIC_ACTIVATE_FILE "/sys/bus/i2c/devices/0-006b/activate"
 
 #ifndef SYN_REPORT
 #define SYN_REPORT          0x00
@@ -198,12 +201,21 @@ int vibrate(int timeout_ms)
     if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
-    } else if (std::ifstream(AWINIC_HAPTIC_ACTIVATE_FILE).good()) {
-        write_to_file(AWINIC_HAPTIC_DURATION_FILE, tout);
-        write_to_file(AWINIC_HAPTIC_ACTIVATE_FILE, "1");
-    } else if (std::ifstream(ICS_HAPTIC_ACTIVATE_FILE).good()) {
-        write_to_file(ICS_HAPTIC_DURATION_FILE, tout);
-        write_to_file(ICS_HAPTIC_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(FA_HAPTIC_ACTIVATE_FILE).good()) {
+        write_to_file(FA_HAPTIC_DURATION_FILE, tout);
+        write_to_file(FA_HAPTIC_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(FC_HAPTIC_ACTIVATE_FILE).good()) {
+        write_to_file(FC_HAPTIC_DURATION_FILE, tout);
+        write_to_file(FC_HAPTIC_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(FE_HAPTIC_ACTIVATE_FILE).good()) {
+        write_to_file(FE_HAPTIC_DURATION_FILE, tout);
+        write_to_file(FE_HAPTIC_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(FF_HAPTIC_ACTIVATE_FILE).good()) {
+        write_to_file(FF_HAPTIC_DURATION_FILE, tout);
+        write_to_file(FF_HAPTIC_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(SB_HAPTIC_ACTIVATE_FILE).good()) {
+        write_to_file(SB_HAPTIC_DURATION_FILE, tout);
+        write_to_file(SB_HAPTIC_ACTIVATE_FILE, "1");
     } else {
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
-- 
2.55.0

