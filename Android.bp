// Soong modules for the klee OrangeFox device tree

// libc++ verbose-abort shim for stock vendor HALs.
cc_library_shared {
    name: "libklee_libcxx_compat",
    srcs: ["src/libcxx_compat/libcxx_compat.cpp"],
    compile_multilib: "64",
    recovery_available: true,
    stl: "none",
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// Stock AIDL stable-C prebuilts used by the OMAPI bridge.
cc_prebuilt_library_shared {
    name: "klee_android.hardware.secure_element-V1-ndk",
    srcs: ["recovery/root/vendor/lib64/android.hardware.secure_element-V1-ndk.so"],
    compile_multilib: "64",
    recovery_available: true,
    check_elf_files: false,
    stl: "none",
}

cc_prebuilt_library_shared {
    name: "klee_android.se.omapi-V1-ndk",
    srcs: ["recovery/root/vendor/lib64/android.se.omapi-V1-ndk.so"],
    compile_multilib: "64",
    recovery_available: true,
    check_elf_files: false,
    stl: "none",
}

// OMAPI service bridge backed by the eSE Secure Element HAL.
cc_binary {
    name: "klee_omapi_bridge",
    recovery: true,
    srcs: ["src/omapi_bridge/omapi_bridge.cpp"],
    generated_headers: [
        "android.hardware.secure_element-V1-ndk-source",
        "android.se.omapi-V1-ndk-source",
    ],
    shared_libs: [
        "klee_android.hardware.secure_element-V1-ndk",
        "klee_android.se.omapi-V1-ndk",
        "libklee_libcxx_compat",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// Maps raw preloader partitions into /dev/block/mapper devices (UFS/eMMC).
cc_binary {
    name: "create_pl_dev",
    srcs: ["src/create_pl_dev/create_pl_dev.cpp"],
    init_rc: ["src/create_pl_dev/create_pl_dev.rc"],
    recovery_available: true,
    static_libs: [
        "libfs_mgr",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
